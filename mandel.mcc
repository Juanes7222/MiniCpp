int main() {
    
    Animal a = new Animal();
    a.setName("Buddy");
    a.setAge(3);
    a.printInfo();

    Dog d = new Dog();
    d.setName("Charlie");
    d.setAge(2);
    d.setBreed("Golden Retriever");
    d.printInfo();

    return 0;
}
